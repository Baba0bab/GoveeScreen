<Window x:Class="GoveeScreenV2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoveeScreen"
        Width="440" Height="700" MinWidth="380" MinHeight="560"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI Variable, Segoe UI"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">

            <!-- En-tête -->
            <Grid Margin="2,4,2,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="GoveeScreen" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="v2" FontSize="12" Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Top" Margin="5,3,0,0" FontWeight="SemiBold"/>
                </StackPanel>
                <Border x:Name="StatusPill" HorizontalAlignment="Right" VerticalAlignment="Center"
                        CornerRadius="12" Padding="10,5" Background="#FF3A3A20">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FFFFC24B"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="StatusText" Text="Démarrage…" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Aperçu couleur -->
            <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True" Margin="0,0,0,14">
                <Grid>
                    <Border x:Name="ColorPreview" Height="110" Background="#FF000000">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                        </Border.Effect>
                    </Border>
                    <Border VerticalAlignment="Bottom" Background="#B016161C" Padding="14,8">
                        <Grid>
                            <TextBlock x:Name="ColorText" Text="RGB —" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="BrightnessText" Text="Luminosité —" FontSize="13"
                                       HorizontalAlignment="Right" Foreground="{StaticResource TextDimBrush}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Appareil -->
            <TextBlock Text="APPAREIL GOVEE" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="IpTextBox" Grid.Column="0" Margin="0,0,8,0"
                                 VerticalContentAlignment="Center"
                                 LostFocus="IpTextBox_LostFocus" KeyDown="IpTextBox_KeyDown"/>
                        <Button x:Name="ScanButton" Grid.Column="1" Content="Détecter"
                                Style="{StaticResource AccentButton}" Click="ScanButton_Click"/>
                    </Grid>
                    <ComboBox x:Name="DevicesCombo" Margin="0,8,0,0" Visibility="Collapsed"
                              SelectionChanged="DevicesCombo_SelectionChanged"/>
                    <TextBlock x:Name="ScanStatus" Margin="2,8,0,0" FontSize="12"
                               Foreground="{StaticResource TextDimBrush}" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Écran -->
            <TextBlock Text="ÉCRAN SOURCE" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="MonitorCombo" Grid.Column="0" Margin="0,0,8,0"
                              SelectionChanged="MonitorCombo_SelectionChanged"/>
                    <Button Grid.Column="1" Content="⟳" FontSize="15" Padding="12,6"
                            ToolTip="Rafraîchir la liste des écrans" Click="RefreshMonitors_Click"/>
                </Grid>
            </Border>

            <!-- Luminosité -->
            <TextBlock Text="LUMINOSITÉ" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Slider x:Name="BrightnessSlider" Minimum="1" Maximum="4"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            ValueChanged="BrightnessSlider_ValueChanged"/>
                    <Grid Margin="4,6,4,0">
                        <TextBlock Text="50%" FontSize="11" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="100%" FontSize="11" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" Margin="-70,0,0,0"/>
                        <TextBlock Text="200%" FontSize="11" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" Margin="70,0,0,0"/>
                        <TextBlock Text="Max" FontSize="11" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <CheckBox x:Name="SmoothCheck" Content="Lissage des transitions" Margin="2,12,0,2"
                              Checked="SmoothCheck_Changed" Unchecked="SmoothCheck_Changed"/>
                </StackPanel>
            </Border>

            <!-- Options -->
            <TextBlock Text="OPTIONS" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <CheckBox x:Name="StartupCheck" Content="Démarrer avec Windows" Margin="2,2,0,2"
                              Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed"/>
                    <CheckBox x:Name="MinimizedCheck" Content="Lancer en arrière-plan (barre des tâches)"
                              Margin="2,10,0,2"
                              Checked="MinimizedCheck_Changed" Unchecked="MinimizedCheck_Changed"/>
                    <Grid Margin="2,12,0,2">
                        <TextBlock Text="Fréquence de capture" VerticalAlignment="Center"
                                   ToolTip="Auto : fluidité maximale (jusqu'à 60 FPS, uniquement quand l'image change). Manuel : plafond fixe, plus bas = moins de charge GPU/CPU."/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox x:Name="FpsAutoCheck" Content="Auto" VerticalAlignment="Center" Margin="0,0,10,0"
                                      Checked="FpsAutoCheck_Changed" Unchecked="FpsAutoCheck_Changed"/>
                            <ComboBox x:Name="FpsCombo" Width="90"
                                      ItemStringFormat="{}{0} FPS"
                                      SelectionChanged="FpsCombo_SelectionChanged"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PauseButton" Grid.Column="0" Content="⏸  Pause" Margin="0,0,5,0"
                        Padding="14,10" Click="PauseButton_Click"/>
                <Button Grid.Column="1" Content="⬇  Réduire" Margin="5,0,0,0"
                        Padding="14,10" Click="MinimizeToTray_Click"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>
