<Window x:Class="GoveeScreenV2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GoveeScreenV2.UI"
        Title="GoveeScreen"
        Width="920" Height="640" MinWidth="580" MinHeight="480"
        Background="{StaticResource BaseBrush}"
        FontFamily="{StaticResource TextFont}"
        FontSize="14"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Menu latéral ================= -->
        <!-- Replié à 56 px : seules les icônes (alignées sur 40 px) restent visibles -->
        <Border x:Name="Sidebar" Width="240" ClipToBounds="True">
            <DockPanel Margin="8,4,8,12">

                <Button x:Name="NavToggleButton" DockPanel.Dock="Top" Style="{StaticResource IconButton}"
                        Content="&#xE700;" HorizontalAlignment="Left" Margin="0,0,0,8"
                        ToolTip="{ui:Tr Nav.Toggle}" Click="NavToggleButton_Click"/>

                <!-- Pied : état de la synchronisation, visible depuis toutes les pages -->
                <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="0,12,0,0"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
                    <Grid Width="224" Height="40" HorizontalAlignment="Left">
                        <Grid x:Name="SidebarSwatchHost" Width="40" HorizontalAlignment="Left" Background="Transparent">
                            <Ellipse x:Name="SidebarSwatch" Width="24" Height="24"
                                     Stroke="#33FFFFFF" StrokeThickness="1"/>
                            <Ellipse x:Name="SidebarStatusDot" Width="10" Height="10" Margin="18,18,0,0"
                                     Stroke="{StaticResource BaseBrush}" StrokeThickness="2"/>
                        </Grid>
                        <StackPanel Margin="48,0,44,0" VerticalAlignment="Center">
                            <TextBlock x:Name="SidebarStatusText" Text="{ui:Tr Status.Starting}" FontSize="13"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="SidebarStatusDetail" FontSize="12" Margin="0,1,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button x:Name="SidebarPauseButton" Style="{StaticResource IconButton}" Width="36"
                                HorizontalAlignment="Right" Content="&#xE769;"
                                Click="PauseButton_Click"/>
                    </Grid>
                </Border>

                <RadioButton x:Name="NavSettings" DockPanel.Dock="Bottom" Style="{StaticResource NavItem}"
                             Tag="&#xE713;" Content="{ui:Tr Nav.Settings}" Checked="Nav_Checked"/>

                <!-- Mise à jour téléchargée : redémarrer pour l'installer (au-dessus de Paramètres) -->
                <Button x:Name="SidebarUpdateButton" DockPanel.Dock="Bottom" Style="{StaticResource SidebarAction}"
                        Tag="&#xE777;" Visibility="Collapsed" Click="AppUpdateInstall_Click"/>

                <StackPanel>
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}"
                                 Tag="&#xE80F;" Content="{ui:Tr Nav.Home}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavDevice" Style="{StaticResource NavItem}"
                                 Tag="&#xEA80;" Content="{ui:Tr Nav.Device}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavDisplay" Style="{StaticResource NavItem}"
                                 Tag="&#xE7F4;" Content="{ui:Tr Nav.Display}" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Contenu ================= -->
        <Border Grid.Column="1" Background="{StaticResource LayerBrush}" BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" Focusable="False">
                <Grid x:Name="PageHost" MaxWidth="820" Margin="36,28,36,36">

                    <!-- ========== Accueil ========== -->
                    <StackPanel x:Name="HomePage">
                        <TextBlock Text="{ui:Tr Nav.Home}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{ui:Tr Home.Subtitle}"
                                   Style="{StaticResource PageSubtitle}"/>

                        <!-- Carte principale : couleur en direct + pause -->
                        <Border Style="{StaticResource Card}" Padding="0" CornerRadius="12">
                            <Grid>
                                <Border CornerRadius="12" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop x:Name="HeroTintStop" Color="#00000000" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="0.8"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Grid Margin="28,26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="112" Height="112" Margin="0,0,28,0" VerticalAlignment="Center">
                                        <!-- Halo : dégradé radial (rempli dans le code), déborde de 30 px autour de l'orbe -->
                                        <Ellipse x:Name="OrbGlow" Width="172" Height="172" Margin="-30" Opacity="0"/>
                                        <Ellipse x:Name="Orb" Width="100" Height="100" Stroke="#26FFFFFF" StrokeThickness="1"/>
                                        <Ellipse Width="100" Height="100" IsHitTestVisible="False">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush GradientOrigin="0.3,0.25" Center="0.35,0.3" RadiusX="0.75" RadiusY="0.75">
                                                    <GradientStop Color="#30FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="HeroStatusDot" Width="8" Height="8" Margin="0,0,8,0"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock x:Name="HeroStatusText" Text="{ui:Tr Status.Starting}" FontSize="13"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="HeroMonitorText" Text="—" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="24" FontWeight="SemiBold" Margin="0,6,0,2"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="HeroDetailText" Text=" " FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <WrapPanel Margin="0,18,0,-8">
                                            <Button x:Name="PauseButton" Style="{StaticResource AccentButton}"
                                                    Tag="&#xE769;" Content="{ui:Tr Pause.Pause}" MinWidth="160" Margin="0,0,8,8"
                                                    ToolTip="{ui:Tr Pause.Tooltip}"
                                                    Click="PauseButton_Click"/>
                                            <Button Tag="&#xE921;" Content="{ui:Tr Home.Hide}" Margin="0,0,8,8"
                                                    ToolTip="{ui:Tr Home.HideTooltip}"
                                                    Click="HideButton_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <TextBlock Text="{ui:Tr Home.Rendering}" Style="{StaticResource SectionHeader}"/>
                        <ui:SettingCard Icon="&#xE706;" Header="{ui:Tr Home.Intensity}"
                                        Description="{ui:Tr Home.IntensityDesc}">
                            <Border Style="{StaticResource SegmentedHost}">
                                <StackPanel x:Name="BrightnessSegments" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Brightness" Tag="1"
                                                 Content="{ui:Tr Brightness.Level1}" Checked="BrightnessSegment_Checked"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Brightness" Tag="2"
                                                 Content="{ui:Tr Brightness.Level2}" Checked="BrightnessSegment_Checked"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Brightness" Tag="3"
                                                 Content="{ui:Tr Brightness.Level3}" Checked="BrightnessSegment_Checked"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Brightness" Tag="4"
                                                 Content="{ui:Tr Brightness.Level4}" Checked="BrightnessSegment_Checked"/>
                                </StackPanel>
                            </Border>
                        </ui:SettingCard>

                        <TextBlock Text="{ui:Tr Home.Configuration}" Style="{StaticResource SectionHeader}"/>
                        <UniformGrid x:Name="SummaryTiles" Columns="3" Margin="0,0,-8,-8">
                            <Button Style="{StaticResource TileButton}" Margin="0,0,8,8" Tag="1"
                                    ToolTip="{ui:Tr Home.TileDeviceTooltip}" Click="Tile_Click">
                                <Grid>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEA80;" FontSize="18"
                                               VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <StackPanel Margin="32,0,16,0">
                                        <TextBlock Text="{ui:Tr Nav.Device}" Style="{StaticResource Caption}"/>
                                        <TextBlock x:Name="TileDeviceText" FontWeight="SemiBold" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12"
                                               HorizontalAlignment="Right" Foreground="{StaticResource TextTertiaryBrush}"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource TileButton}" Margin="0,0,8,8" Tag="2"
                                    ToolTip="{ui:Tr Home.TileDisplayTooltip}" Click="Tile_Click">
                                <Grid>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="18"
                                               VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <StackPanel Margin="32,0,16,0">
                                        <TextBlock Text="{ui:Tr Nav.Display}" Style="{StaticResource Caption}"/>
                                        <TextBlock x:Name="TileDisplayText" FontWeight="SemiBold" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12"
                                               HorizontalAlignment="Right" Foreground="{StaticResource TextTertiaryBrush}"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource TileButton}" Margin="0,0,8,8" Tag="2"
                                    ToolTip="{ui:Tr Home.TileCaptureTooltip}" Click="Tile_Click">
                                <Grid>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEC4A;" FontSize="18"
                                               VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <StackPanel Margin="32,0,16,0">
                                        <TextBlock Text="{ui:Tr Display.Capture}" Style="{StaticResource Caption}"/>
                                        <TextBlock x:Name="TileCaptureText" FontWeight="SemiBold" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12"
                                               HorizontalAlignment="Right" Foreground="{StaticResource TextTertiaryBrush}"/>
                                </Grid>
                            </Button>
                        </UniformGrid>
                    </StackPanel>

                    <!-- ========== Lampe ========== -->
                    <StackPanel x:Name="DevicePage" Visibility="Collapsed">
                        <TextBlock Text="{ui:Tr Nav.Device}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{ui:Tr Device.Subtitle}"
                                   Style="{StaticResource PageSubtitle}"/>

                        <TextBlock Text="{ui:Tr Device.Current}" Style="{StaticResource SectionHeader}" Margin="2,0,0,8"/>
                        <ui:SettingCard x:Name="IpCard" Icon="&#xE968;" Header="{ui:Tr Device.Ip}">
                            <TextBox x:Name="IpTextBox" Width="170"
                                     LostFocus="IpTextBox_LostFocus" KeyDown="IpTextBox_KeyDown"/>
                        </ui:SettingCard>
                        <ui:SettingCard x:Name="ConnectionCard" Icon="&#xE701;" Header="{ui:Tr Device.Connection}">
                            <StackPanel Orientation="Horizontal">
                                <Control x:Name="TestSpinner" Style="{StaticResource Spinner}"
                                         Margin="0,0,12,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="TestResultIcon" Style="{StaticResource Icon}" FontSize="14"
                                           Margin="0,0,12,0" Visibility="Collapsed"/>
                                <Button x:Name="TestButton" Content="{ui:Tr Device.Test}" MinWidth="90" Click="TestButton_Click"/>
                            </StackPanel>
                        </ui:SettingCard>

                        <Grid>
                            <TextBlock Text="{ui:Tr Device.Detected}" Style="{StaticResource SectionHeader}"/>
                            <Button x:Name="ScanButton" Tag="&#xE721;" Content="{ui:Tr Device.Scan}"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                    Click="ScanButton_Click"/>
                        </Grid>
                        <Border x:Name="ScanPlaceholder" Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Control x:Name="ScanSpinner" Style="{StaticResource Spinner}"
                                         Margin="0,0,12,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="ScanStatus" Style="{StaticResource Caption}" FontSize="13"
                                           VerticalAlignment="Center"
                                           Text="{ui:Tr Device.ScanPrompt}"/>
                            </StackPanel>
                        </Border>
                        <ListBox x:Name="DevicesList" Style="{StaticResource CardList}" Visibility="Collapsed"
                                 SelectionChanged="DevicesList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA80;" FontSize="24"
                                                   HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                        <TextBlock Text="{Binding Model}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Ip}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding DeviceId}" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Style="{StaticResource Card}" Background="{StaticResource InsetBrush}" Margin="0,16,0,0">
                            <Grid>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource AccentLightBrush}"
                                           VerticalAlignment="Top" Margin="0,1,0,0"/>
                                <!-- Rempli dans le code : la partie entre | de Device.LanHint est mise en avant -->
                                <TextBlock x:Name="LanHintText" Style="{StaticResource Caption}" FontSize="13" Margin="30,0,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ========== Écran ========== -->
                    <StackPanel x:Name="DisplayPage" Visibility="Collapsed">
                        <TextBlock Text="{ui:Tr Nav.Display}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{ui:Tr Display.Subtitle}"
                                   Style="{StaticResource PageSubtitle}"/>

                        <Grid>
                            <TextBlock Text="{ui:Tr Display.Source}" Style="{StaticResource SectionHeader}" Margin="2,0,0,8"/>
                            <Button Tag="&#xE72C;" Content="{ui:Tr Display.Refresh}" HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom" Margin="0,0,0,8"
                                    ToolTip="{ui:Tr Display.RefreshTooltip}" Click="RefreshMonitors_Click"/>
                        </Grid>
                        <ListBox x:Name="MonitorsList" Style="{StaticResource CardList}"
                                 SelectionChanged="MonitorsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="24"
                                                   HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Resolution}" Style="{StaticResource Caption}"
                                                       VerticalAlignment="Center"/>
                                            <Border x:Name="PrimaryBadge" Style="{StaticResource Badge}" Margin="8,0,0,0">
                                                <TextBlock Text="{ui:Tr Display.Primary}" FontSize="11" Foreground="{StaticResource AccentLightBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsPrimary}" Value="False">
                                            <Setter TargetName="PrimaryBadge" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border x:Name="NoMonitorPlaceholder" Style="{StaticResource Card}" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Caption}" FontSize="13"
                                       Text="{ui:Tr Display.None}"/>
                        </Border>

                        <TextBlock Text="{ui:Tr Display.Capture}" Style="{StaticResource SectionHeader}" Margin="2,16,0,8"/>
                        <ui:SettingCard Icon="&#xEC4A;" Header="{ui:Tr Display.Fps}"
                                        Description="{ui:Tr Display.FpsDesc}">
                            <Border Style="{StaticResource SegmentedHost}">
                                <StackPanel x:Name="FpsSegments" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Fps" Tag="0"
                                                 Content="{ui:Tr Display.Auto}" Checked="FpsSegment_Checked"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Fps" Tag="10"
                                                 Content="10" MinWidth="40" Checked="FpsSegment_Checked"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Fps" Tag="15"
                                                 Content="15" MinWidth="40" Checked="FpsSegment_Checked"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Fps" Tag="30"
                                                 Content="30" MinWidth="40" Checked="FpsSegment_Checked"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Fps" Tag="60"
                                                 Content="60" MinWidth="40" Checked="FpsSegment_Checked"/>
                                </StackPanel>
                            </Border>
                        </ui:SettingCard>
                        <ui:SettingCard Icon="&#xE790;" Header="{ui:Tr Display.Smooth}"
                                        Description="{ui:Tr Display.SmoothDesc}">
                            <CheckBox x:Name="SmoothSwitch" Style="{StaticResource Switch}"
                                      Checked="SmoothSwitch_Changed" Unchecked="SmoothSwitch_Changed"/>
                        </ui:SettingCard>
                    </StackPanel>

                    <!-- ========== Paramètres ========== -->
                    <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
                        <TextBlock Text="{ui:Tr Nav.Settings}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{ui:Tr Settings.Subtitle}"
                                   Style="{StaticResource PageSubtitle}"/>

                        <TextBlock Text="{ui:Tr Settings.General}" Style="{StaticResource SectionHeader}" Margin="2,0,0,8"/>
                        <ui:SettingCard Icon="&#xE774;" Header="{ui:Tr Settings.Language}"
                                        Description="{ui:Tr Settings.LanguageDesc}">
                            <StackPanel Orientation="Horizontal">
                                <!-- Visible seulement si la langue choisie diffère de celle affichée -->
                                <Button x:Name="LanguageRestartButton" Style="{StaticResource AccentButton}" Tag="&#xE72C;"
                                        Content="{ui:Tr Settings.LanguageRestart}" Margin="0,0,12,0" Visibility="Collapsed"
                                        Click="LanguageRestart_Click"/>
                                <ComboBox x:Name="LanguageCombo" Width="230" SelectionChanged="LanguageCombo_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Flag}" Width="20" Height="15" Margin="0,0,10,0"
                                                       VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </ui:SettingCard>

                        <TextBlock Text="{ui:Tr Settings.Startup}" Style="{StaticResource SectionHeader}"/>
                        <ui:SettingCard Icon="&#xE7E8;" Header="{ui:Tr Settings.StartWithWindows}"
                                        Description="{ui:Tr Settings.StartWithWindowsDesc}">
                            <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}"
                                      Checked="StartupSwitch_Changed" Unchecked="StartupSwitch_Changed"/>
                        </ui:SettingCard>
                        <ui:SettingCard Icon="&#xE73F;" Header="{ui:Tr Settings.StartHidden}"
                                        Description="{ui:Tr Settings.StartHiddenDesc}">
                            <CheckBox x:Name="MinimizedSwitch" Style="{StaticResource Switch}"
                                      Checked="MinimizedSwitch_Changed" Unchecked="MinimizedSwitch_Changed"/>
                        </ui:SettingCard>

                        <TextBlock Text="{ui:Tr Settings.Lock}" Style="{StaticResource SectionHeader}"/>
                        <ui:SettingCard Icon="&#xE72E;" Header="{ui:Tr Settings.PauseOnLock}"
                                        Description="{ui:Tr Settings.PauseOnLockDesc}">
                            <CheckBox x:Name="PauseOnLockSwitch" Style="{StaticResource Switch}"
                                      Checked="PauseOnLockSwitch_Changed" Unchecked="PauseOnLockSwitch_Changed"/>
                        </ui:SettingCard>
                        <!-- Sous-option : alignée sur le texte de la carte parente, active seulement avec elle -->
                        <ui:SettingCard Header="{ui:Tr Settings.LampOnLockScreen}" Margin="38,0,0,4"
                                        IsEnabled="{Binding IsChecked, ElementName=PauseOnLockSwitch}"
                                        Description="{ui:Tr Settings.LampOnLockScreenDesc}">
                            <CheckBox x:Name="LampOnLockScreenSwitch" Style="{StaticResource Switch}"
                                      Checked="LampOnLockScreenSwitch_Changed" Unchecked="LampOnLockScreenSwitch_Changed"/>
                        </ui:SettingCard>

                        <TextBlock Text="{ui:Tr Settings.Inactivity}" Style="{StaticResource SectionHeader}"/>
                        <ui:SettingCard Icon="&#xE708;" Header="{ui:Tr Settings.StaticScreenOff}"
                                        Description="{ui:Tr Settings.StaticScreenOffDesc}">
                            <CheckBox x:Name="StaticScreenOffSwitch" Style="{StaticResource Switch}"
                                      Checked="StaticScreenOffSwitch_Changed" Unchecked="StaticScreenOffSwitch_Changed"/>
                        </ui:SettingCard>
                        <ui:SettingCard Header="{ui:Tr Settings.StaticScreenDelay}" Margin="38,0,0,4"
                                        IsEnabled="{Binding IsChecked, ElementName=StaticScreenOffSwitch}"
                                        Description="{ui:Tr Settings.StaticScreenDelayDesc}">
                            <Border Style="{StaticResource SegmentedHost}">
                                <StackPanel x:Name="StaticScreenDelaySegments" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="StaticScreenDelay" Tag="1" Checked="StaticScreenDelay_Checked"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="StaticScreenDelay" Tag="5" Checked="StaticScreenDelay_Checked"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="StaticScreenDelay" Tag="10" Checked="StaticScreenDelay_Checked"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="StaticScreenDelay" Tag="30" Checked="StaticScreenDelay_Checked"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="StaticScreenDelay" Tag="60" Checked="StaticScreenDelay_Checked"/>
                                </StackPanel>
                            </Border>
                        </ui:SettingCard>

                        <TextBlock Text="{ui:Tr Settings.Window}" Style="{StaticResource SectionHeader}"/>
                        <ui:SettingCard Icon="&#xE711;" Header="{ui:Tr Settings.CloseToTray}"
                                        Description="{ui:Tr Settings.CloseToTrayDesc}">
                            <CheckBox x:Name="CloseToTraySwitch" Style="{StaticResource Switch}"
                                      Checked="CloseToTraySwitch_Changed" Unchecked="CloseToTraySwitch_Changed"/>
                        </ui:SettingCard>

                        <TextBlock Text="{ui:Tr Settings.Updates}" Style="{StaticResource SectionHeader}"/>
                        <ui:SettingCard x:Name="AppUpdateCard" Icon="&#xE777;" Header="{ui:Tr Settings.AppUpdates}">
                            <StackPanel Orientation="Horizontal">
                                <Control x:Name="AppUpdateSpinner" Style="{StaticResource Spinner}" Margin="0,0,12,0"
                                         Visibility="Collapsed"/>
                                <Button x:Name="AppUpdateCheckButton" Tag="&#xE72C;" Content="{ui:Tr Settings.UpdateCheck}"
                                        Click="AppUpdateCheck_Click"/>
                                <Button x:Name="AppUpdateInstallButton" Style="{StaticResource AccentButton}" Tag="&#xE777;"
                                        Content="{ui:Tr AppUpdate.RestartInstall}" Visibility="Collapsed"
                                        Click="AppUpdateInstall_Click"/>
                            </StackPanel>
                        </ui:SettingCard>
                        <Border x:Name="AppUpdateNotesCard" Style="{StaticResource Card}" Background="{StaticResource InsetBrush}"
                                Margin="0,0,0,4" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="AppUpdateNotesTitle" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock x:Name="AppUpdateNotesText" Style="{StaticResource Caption}" FontSize="13"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <ui:SettingCard x:Name="AppUpdateAutoCheckCard" Icon="&#xE895;" Header="{ui:Tr Settings.AutoCheck}"
                                        Description="{ui:Tr Settings.AutoCheckDesc}">
                            <CheckBox x:Name="AppUpdateCheckSwitch" Style="{StaticResource Switch}"
                                      Checked="AppUpdateCheckSwitch_Changed" Unchecked="AppUpdateCheckSwitch_Changed"/>
                        </ui:SettingCard>
                        <ui:SettingCard x:Name="AppUpdateAutoInstallCard" Icon="&#xE896;" Header="{ui:Tr Settings.AutoInstall}"
                                        Description="{ui:Tr Settings.AutoInstallDesc}">
                            <CheckBox x:Name="AppUpdateAutoInstallSwitch" Style="{StaticResource Switch}"
                                      Checked="AppUpdateAutoInstallSwitch_Changed" Unchecked="AppUpdateAutoInstallSwitch_Changed"/>
                        </ui:SettingCard>
                        <ui:SettingCard x:Name="AppUpdatePrereleaseCard" Icon="&#xE9D9;" Header="{ui:Tr Settings.Prerelease}"
                                        Description="{ui:Tr Settings.PrereleaseDesc}">
                            <CheckBox x:Name="AppUpdatePrereleaseSwitch" Style="{StaticResource Switch}"
                                      Checked="AppUpdatePrereleaseSwitch_Changed" Unchecked="AppUpdatePrereleaseSwitch_Changed"/>
                        </ui:SettingCard>

                        <TextBlock Text="{ui:Tr Settings.About}" Style="{StaticResource SectionHeader}"/>
                        <ui:SettingCard x:Name="AboutCard" Icon="&#xE946;" Header="GoveeScreen">
                            <Button Tag="&#xE8B7;" Content="{ui:Tr Settings.ConfigFolder}" Click="OpenConfigFolder_Click"/>
                        </ui:SettingCard>
                        <ui:SettingCard Icon="&#xE765;" Header="{ui:Tr Settings.Shortcuts}"
                                        Description="{ui:Tr Settings.ShortcutsDesc}"/>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
