<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- SDK 26100 : GraphicsCaptureSession.MinUpdateInterval (Windows 11 24H2+, détecté à l'exécution) -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GoveeScreen</AssemblyName>
    <RootNamespace>GoveeScreenV2</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Point d'entrée personnalisé (Program.cs) : Velopack doit passer avant WPF -->
    <StartupObject>GoveeScreenV2.Program</StartupObject>
    <!-- Version : remplacée par celle du tag (v2.1.0) dans le workflow de release -->
    <VersionPrefix>2.0.0</VersionPrefix>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>GoveeScreen</Product>
    <AssemblyTitle>GoveeScreen</AssemblyTitle>
    <Description>Sync a Govee lamp with the colors of your screen</Description>
    <Authors>Baba0bab</Authors>
    <Copyright>Copyright © 2025-2026 Baba0bab — GPL-3.0-or-later</Copyright>
    <RepositoryUrl>https://github.com/Baba0bab/GoveeScreen</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <!-- Code précompilé à la publication : démarrage plus rapide (lancement avec Windows) -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Tas de quelques Mo : pas besoin du thread de GC en arrière-plan -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en;fr;de;es</SatelliteResourceLanguages>
    <!-- Publication : ni documentation XML des paquets ni .pdb séparé (symboles intégrés à l'exe) -->
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Builds reproductibles sur GitHub Actions (chemins sources normalisés) -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

  <!-- Les tests accèdent au shader (ScreenCapturer.DownscaleShader) et au cadencement -->
  <ItemGroup>
    <InternalsVisibleTo Include="GoveeScreen.Tests" />
  </ItemGroup>

  <!-- Projet de tests et fichiers du dépôt : hors application -->
  <ItemGroup>
    <Compile Remove="Tests\**;artifacts\**" />
    <None Remove="Tests\**;artifacts\**" />
    <Page Remove="Tests\**;artifacts\**" />
  </ItemGroup>

  <!-- Traductions de l'interface, lues par Core/Loc.cs -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" LogicalName="GoveeScreenV2.Localization.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Licences livrées avec l'application -->
  <ItemGroup>
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
